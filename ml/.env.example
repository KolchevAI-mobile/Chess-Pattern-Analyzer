# Скопируйте в .env и настройте под себя (файл .env не коммитится).

# Путь к бинарнику Stockfish. Если пусто — работает эвристический оценщик
# (degraded-режим: оценка по материалу).
STOCKFISH_PATH=

# Глубина анализа Stockfish. 10 — компромисс скорость/качество для MVP.
STOCKFISH_DEPTH=10
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64

# Ограничения на один запрос
MAX_GAMES_PER_REQUEST=10
MAX_PLIES_PER_GAME=140

# Определения фаз и ошибок (cp)
OPENING_PLIES=20
ENDGAME_MAJOR_MINOR_LIMIT=6
INACCURACY_CP=50
MISTAKE_CP=100
BLUNDER_CP=200
LOW_CLOCK_SECONDS=30
NORMAL_CLOCK_SECONDS=60
